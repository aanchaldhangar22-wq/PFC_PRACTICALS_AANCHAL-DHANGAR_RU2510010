#include <stdio.h>
//AANCHAL DHANGAR RU 25 10010//
int main() {
int n, m, i, j;
int a[10][10];
int sum;
printf("Enter number of rows and columns: ");
scanf("%d", &n);
scanf("%d", &m);
printf("Enter elements of %d x %d matrix:\n", n, m);
for (i = 0; i < n; i++) {
for (j = 0; j < m; j++) {
scanf("%d", &a[i][j]);
}
}
for (i = 0; i < n; i++) {
sum = 0;
for (j = 0; j < m; j++) {
sum += a[i][j];
}
printf("Sum of row %d = %d\n", i + 1, sum);
}
return 0;
}
