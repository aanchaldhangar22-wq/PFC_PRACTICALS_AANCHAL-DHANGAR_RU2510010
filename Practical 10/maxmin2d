int main() {
int n, i, j;
int a[10][10];
int max, min;
printf("Enter order of square matrix (n): ");
scanf("%d", &n);
printf("Enter elements of %d x %d matrix:\n", n, n);
for (i = 0; i < n; i++) {
for (j = 0; j < n; j++) {
scanf("%d", &a[i][j]);
}
}
max = a[0][0];
min = a[0][0];
for (i = 0; i < n; i++) {
for (j = 0; j < n; j++) {
if (a[i][j] > max)
max = a[i][j];
if (a[i][j] < min)
min = a[i][j];
}
}
printf("Maximum element in matrix = %d\n", max);
printf("Minimum element in matrix = %d\n", min);
return 0;
}
